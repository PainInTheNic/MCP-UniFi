{
  "name": "unifi-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for managing Ubiquiti UniFi network infrastructure via the official UniFi Network API",
  "author": "PainInTheNic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PainInTheNic/MCP-UniFi.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "unifi-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
